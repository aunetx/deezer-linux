From 73f248b3710a2eada877999df5fa9bb9bbb1a28e Mon Sep 17 00:00:00 2001
From: josselinonduty <contact@josselinonduty.fr>
Date: Mon, 24 Aug 2026 12:00:00 +0200
Subject: [PATCH] feat: custom theme via user-provided CSS file

---
 build/main.js | 44 ++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 44 insertions(+)

diff --git a/build/main.js b/build/main.js
index 3f03fd7..f4ae807 100644
--- a/build/main.js
+++ b/build/main.js
@@ -3628,6 +3628,50 @@
             )
             .catch(() => {});
         });
+      const customThemeArg = process.argv.find((arg) =>
+          arg.startsWith("--custom-theme=")
+        ),
+        customThemeRaw = customThemeArg
+          ? customThemeArg.slice("--custom-theme=".length)
+          : process.env.DZ_CUSTOM_THEME;
+      if (customThemeRaw) {
+        const themePath = external_path_default().resolve(customThemeRaw);
+        let themeKey = null;
+        const applyCustomTheme = () => {
+          const webContents = this.appService.getWebContents();
+          let css;
+          try {
+            css = external_fs_default().readFileSync(themePath, "utf8");
+          } catch (err) {
+            external_electron_log_default().error(
+              "[custom-theme] Could not read theme file: " + themePath,
+              err
+            );
+            return;
+          }
+          const previousKey = themeKey;
+          webContents.insertCSS(css).then((key) => {
+            themeKey = key;
+            previousKey && webContents.removeInsertedCSS(previousKey).catch(() => {});
+          });
+        };
+        this.appService.getWebContents().on("dom-ready", () => {
+          themeKey = null;
+          applyCustomTheme();
+        });
+        try {
+          external_fs_default().watchFile(
+            themePath,
+            { interval: 500 },
+            applyCustomTheme
+          );
+        } catch (err) {
+          external_electron_log_default().error(
+            "[custom-theme] Could not watch theme file",
+            err
+          );
+        }
+      }
       const showTimeout = setTimeout(() => {
         !this.window ||
           this.window.isDestroyed() ||
-- 
