From f9e16f0f5975b2520a9fe645361827fc4aef2703 Mon Sep 17 00:00:00 2001
From: Kmc <kmcgurty1@gmail.com>
Date: Mon, 8 Dec 2025 16:15:32 -0500
Subject: [PATCH] feat: adjust volume on mouse wheel

---
 build/main.js | 32 ++++++++++++++++++++++++++++++++
 1 file changed, 32 insertions(+)

diff --git a/build/main.js b/build/main.js
index fe3df20..b1f2432 100644
--- a/build/main.js
+++ b/build/main.js
@@ -3564,6 +3564,38 @@
             .executeJavaScript("delete window.Notification;")
             .catch(() => {});
         });
+      this.appService.getWebContents().on("dom-ready", () => {
+        this.appService
+          .getWebContents()
+          .executeJavaScript(
+            `(() => {
+              if (window.__dzVolumeWheel) return;
+              window.__dzVolumeWheel = !0;
+              document.addEventListener(
+                "wheel",
+                (e) => {
+                  if (
+                    !e.target.closest(
+                      "#page_player [aria-label='volume button'], #page_player [data-testid='volume_menu']"
+                    )
+                  )
+                    return;
+                  e.preventDefault();
+                  const dzPlayer = window.dzPlayer;
+                  dzPlayer &&
+                    dzPlayer.control.setVolume(
+                      Math.max(
+                        0,
+                        Math.min(1, dzPlayer.volume + 0.05 * Math.sign(e.deltaY) * -1)
+                      )
+                    );
+                },
+                { passive: !1 }
+              );
+            })();`
+          )
+          .catch(() => {});
+      });
       const showTimeout = setTimeout(() => {
         !this.window ||
           this.window.isDestroyed() ||
