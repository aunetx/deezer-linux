Subject: [PATCH] feat: disable animations

---
 build/main.js | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/build/main.js b/build/main.js
index cf4b722..a2e131a 100644
--- a/build/main.js
+++ b/build/main.js
@@ -3543,6 +3543,17 @@
               `.alert-wrapper:has(> div[data-testid="alert-AppOffline"]) { display: none !important; }`
             );
         });
+      if (
+        process.argv.some((arg) => arg === "--disable-animations") ||
+        "yes" === process.env.DZ_DISABLE_ANIMATIONS
+      )
+        this.appService.getWebContents().on("dom-ready", () => {
+          this.appService
+            .getWebContents()
+            .insertCSS(
+              `* { animation: none !important; transition: none !important; }`
+            );
+        });
       const showTimeout = setTimeout(() => {
         !this.window ||
           this.window.isDestroyed() ||
