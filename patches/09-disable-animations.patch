--- a/build/main.js
+++ b/build/main.js
@@ -3819,6 +3819,18 @@
           }),
         isPlatform(PLATFORM.WINDOWS) && this.loadMenu(),
         this.appService.loadPage(this.deepLink.getPathFromArgv(process.argv));
+      if (process.argv.includes("--disable-animations") || process.env.DZ_DISABLE_ANIMATIONS === "yes") {
+        this.appService.getWebContents().on("did-finish-load", () => {
+          const contents = this.appService.getWebContents();
+          if (!contents.getURL().startsWith(`https://${this.domain}/`)) return;
+          contents.insertCSS(`
+          *, *::before, *::after {
+            animation: none !important;
+            transition: none !important;
+          }
+          `, { cssOrigin: "user" }).catch(console.warn);
+        });
+      }
