               break;
             case "player-shuffle-changed":
               renderer_ipc.send("channel-player-shuffle-update", {
@@ -345,12 +389,23 @@
                 canShuffle: event.data.player.hasShuffle,
               });
               break;
+            case "player-volume-changed":
+              renderer_ipc.send(
+                "channel-player-volume-changed",
