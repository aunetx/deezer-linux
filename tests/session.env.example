# Shared Deezer session for logged-in tests (tests/run.sh ... --login).
#
#   cp tests/session.env.example tests/session.env && chmod 600 tests/session.env
#   (or ~/.config/deezer-linux-tests/session.env, or DEEZER_SESSION_FILE=..., or DEEZER_ARL=... in CI)
#
# Use a dedicated test account. This file is git-ignored and is only ever mounted
# read-only into guests; outputs are scrubbed of the value before you see them.
#
# The `arl` cookie of www.deezer.com: browser devtools > Storage/Application >
# Cookies > https://www.deezer.com > arl. Or: tests/run.sh session import-firefox
DEEZER_ARL=
